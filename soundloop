#!/usr/bin/env bash
# soundloop — toca sons aleatórios em background. Brincadeira de escritório: consensual, visível e parável.
# Só macOS: bash + afplay + launchd, zero dependências. O processo é um serviço launchd; nada de PID file/nohup.
set -u

DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
SELF=$DIR/soundloop
LOG=$DIR/soundloop.log
SETTINGS=$DIR/settings   # "modo volume lazy" — gravado pelo start, lido pelo run e pelo status (vale pro autostart)
PLIST=$DIR/soundloop.plist
LABEL=${SOUNDLOOP_LABEL:-com.bzangi.soundloop}   # override só pro test.sh
AGENT=$HOME/Library/LaunchAgents/$LABEL.plist
DOMAIN=gui/$UID
LAZY_SECONDS=1200   # ponytail: lazy start fixo em 20min; vira argumento se alguém pedir
MUTED_CAP=30        # ponytail: Mac no mudo -> desmuta com o volume do sistema limitado a 30% só durante o som, e volta ao mudo

# $1 = modo (normal | slow | fast | MIN-MAX em segundos) -> segundos de espera entre sons
gap_seconds() {
  local range
  case $1 in slow) range=1800-3000 ;; fast) range=10-13 ;; normal) range=90-210 ;; *) range=$1 ;; esac
  local min=${range%-*} max=${range#*-}
  echo $(( min + RANDOM % (max - min + 1) ))
}

# $1 = anterior, resto = candidatos -> um candidato aleatório diferente do anterior (repete se só há 1)
pick_next() {
  local prev=$1 f others=(); shift
  for f in "$@"; do [[ $f != "$prev" ]] && others+=("$f"); done
  (( ${#others[@]} )) || others=("$@")
  echo "${others[RANDOM % ${#others[@]}]}"
}

# $1 = volume em % (0-100) -> ganho linear do afplay (60 -> 0.60, 100 -> 1.00)
pct_to_gain() { printf '%d.%02d' $(( $1 / 100 )) $(( $1 % 100 )); }

# "output volume:75, input volume:48, alert volume:100, output muted:true" -> SYS_VOL=75 SYS_MUTED=true
parse_volume_settings() {
  SYS_VOL=0 SYS_MUTED=false
  [[ $1 =~ output\ volume:([0-9]+).*output\ muted:(true|false) ]] && SYS_VOL=${BASH_REMATCH[1]} SYS_MUTED=${BASH_REMATCH[2]}
}
read_sys_audio() { parse_volume_settings "$(osascript -e 'get volume settings' 2>/dev/null)"; }
set_sys_audio()  { osascript -e "set volume output volume $1" -e "set volume output muted $2" >/dev/null 2>&1; }   # $1 = 0-100, $2 = true|false

read_settings() {
  MODE_=normal VOL_=60 LAZY_=0
  [[ -f $SETTINGS ]] && read -r MODE_ VOL_ LAZY_ < "$SETTINGS"
  VOL_=${VOL_:-60} LAZY_=${LAZY_:-0}
}
settings_str() { read_settings; echo "modo $MODE_, volume $VOL_%$( (( LAZY_ )) && echo ', lazy' )"; }

die()     { echo "$*" >&2; exit 1; }
log()     { echo "$(date '+%F %T') $*"; }
running() { launchctl print "$DOMAIN/$LABEL" 2>/dev/null | grep -q $'^\tstate = running'; }
pid()     { launchctl print "$DOMAIN/$LABEL" 2>/dev/null | grep -m1 'pid = ' | awk '{print $3}'; }

write_plist() {
  cat > "$PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>$SELF</string><string>run</string></array>
  <key>RunAtLoad</key><true/>
  <key>AbandonProcessGroup</key><true/>
  <key>StandardOutPath</key><string>$LOG</string>
  <key>StandardErrorPath</key><string>$LOG</string>
</dict></plist>
PLIST
}

# loop em foreground; é isso que o launchd executa
cmd_run() {
  local prev='' f gap files gain cap note
  read_settings; gain=$(pct_to_gain "$VOL_")
  log "iniciado ($(settings_str))"
  (( LAZY_ )) && { log "lazy: primeiro som em $(( LAZY_SECONDS / 60 ))min"; sleep "$LAZY_SECONDS"; }
  while :; do
    # ponytail: um pool só, relido a cada ciclo (dá pra jogar sons novos sem reiniciar). Pacotes temáticos = subpasta + nome no settings.
    files=("$DIR"/assets/*)
    [[ -e ${files[0]} ]] || { log "nenhum áudio em $DIR/assets"; exit 1; }
    f=$(pick_next "$prev" "${files[@]}")
    read_sys_audio; note=''
    if [[ $SYS_MUTED == true ]]; then
      cap=$(( SYS_VOL < MUTED_CAP ? SYS_VOL : MUTED_CAP ))
      trap 'set_sys_audio "$SYS_VOL" true; exit' TERM INT   # stop no meio do som: o som termina, volta ao mudo, sai. SIGKILL deixa desmutado.
      set_sys_audio "$cap" false
    fi
    /usr/bin/afplay -v "$gain" "$f" || log "erro ao tocar $f"
    if [[ $SYS_MUTED == true ]]; then set_sys_audio "$SYS_VOL" true; trap - TERM INT; note=" (Mac no mudo: toquei a ${cap}% e voltei ao mudo)"; fi
    prev=$f
    gap=$(gap_seconds "$MODE_")
    log "tocou $(basename "$f")$note; próximo em ${gap}s"
    sleep "$gap"
  done
}

# start [normal|slow|fast|MIN-MAX] [N%] [lazy], em qualquer ordem
cmd_start() {
  local a mode=normal vol=60 lazy=0
  for a in "$@"; do
    if [[ $a =~ ^(normal|slow|fast|([0-9]+)-([0-9]+))$ ]]; then
      mode=$a; [[ -n ${BASH_REMATCH[2]} ]] && (( BASH_REMATCH[2] > BASH_REMATCH[3] )) && die "faixa inválida: $a (MIN deve ser <= MAX)"
    elif [[ $a =~ ^([0-9]|[1-9][0-9]|100)%$ ]]; then vol=${a%\%}
    elif [[ $a == lazy ]]; then lazy=1
    else die "argumento inválido: $a (use: slow | fast | MIN-MAX em segundos, N% de volume, lazy)"
    fi
  done
  running && die "já está rodando (PID $(pid), $(settings_str)). Pra trocar: $SELF stop && $SELF start $*"
  echo "$mode $vol $lazy" > "$SETTINGS"
  write_plist
  launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null   # limpa instância carregada mas já encerrada
  launchctl bootstrap "$DOMAIN" "$PLIST" || die "falhou ao iniciar"
  sleep 1
  running || die "falhou ao iniciar, veja $LOG"
  echo "rodando (PID $(pid), $(settings_str)). Parar: $SELF stop"
}

cmd_stop() {
  if running; then launchctl bootout "$DOMAIN/$LABEL"; echo "parado. O som em curso termina sozinho."
  else launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null; echo "não estava rodando"; fi
}

cmd_status() {
  if running; then echo "rodando (PID $(pid), $(settings_str))"; else echo "parado"; fi
  echo "autostart: $([[ -f $AGENT ]] && echo on || echo off)"
  echo "log: $LOG"
}

cmd_enable_autostart() {
  write_plist; mkdir -p "$(dirname "$AGENT")"; cp "$PLIST" "$AGENT"
  echo "autostart ativado: inicia sozinho no próximo login, com as opções do último start ($(settings_str))."
  echo "Aparece em Ajustes do Sistema > Geral > Itens de Início. Desativar: $SELF disable-autostart"
}

cmd_disable_autostart() { rm -f "$AGENT"; echo "autostart desativado. Se estiver rodando agora, continua até: $SELF stop"; }

cmd_uninstall() {
  [[ -e $DIR/.git ]] && die "isso é um checkout git, não uma instalação. Rode a partir de ~/.soundloop."
  cmd_stop; cmd_disable_autostart
  rm -rf "$DIR" && echo "soundloop removido ($DIR)"
}

usage() { cat <<EOT
soundloop — toca sons aleatórios em background. Brincadeira de escritório: consensual, visível e parável.

uso: $SELF <comando>
  start [modo] [N%] [lazy]  inicia (default: normal, 60%, sem lazy). Ordem livre.
                            modo: normal 90-210s | slow 30-50min | fast 10-13s | MIN-MAX segundos
                            N%: volume relativo ao do Mac | lazy: primeiro som só depois de 20min
  stop                      para (o som em curso termina sozinho)
  status                    rodando/parado, PID, modo, volume, autostart
  enable-autostart          inicia sozinho no login com as opções do último start (visível em Itens de Início)
  disable-autostart         remove do login
  uninstall                 stop + disable-autostart + apaga $DIR
obs: toca mesmo com o Mac no mudo (desmuta com o sistema limitado a 30% durante o som; volta ao mudo depois)
log: $LOG
EOT
}

main() {
  case ${1:-help} in
    start) shift; cmd_start "$@" ;;
    stop|status|run|uninstall) "cmd_$1" ;;
    enable-autostart) cmd_enable_autostart ;;
    disable-autostart) cmd_disable_autostart ;;
    help|-h|--help) usage ;;
    *) usage >&2; exit 1 ;;
  esac
}

[[ ${BASH_SOURCE[0]} == "$0" ]] && main "$@"
