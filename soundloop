#!/usr/bin/env bash
# soundloop — toca sons aleatórios em background. Brincadeira de escritório: consensual, visível e parável.
# Só macOS: bash + afplay + launchd, zero dependências. O processo é um serviço launchd; nada de PID file/nohup.
set -u
shopt -s nullglob

DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
SELF=$DIR/soundloop
LOG=$DIR/soundloop.log
SETTINGS=$DIR/settings   # "modo volume lazy pacote" — gravado pelo start, lido pelo run e pelo status (vale pro autostart)
PLIST=$DIR/soundloop.plist
STOP_SOUND=$DIR/assets/stop.mp3   # toca no stop e no uninstall. Arquivos soltos em assets/ não entram no sorteio; pacotes são subpastas.
LABEL=${SOUNDLOOP_LABEL:-com.bzangi.soundloop}   # override só pro test.sh
AGENT=$HOME/Library/LaunchAgents/$LABEL.plist
DOMAIN=gui/$UID
LAZY_SECONDS=1800   # ponytail: lazy start fixo em 30min; vira argumento se alguém pedir
RAMP_START=900 RAMP_MIN=30 RAMP_DURATION=7200   # ponytail: ramp quadrática no tempo (ease-in): gap = MIN + (START-MIN)*(1-(t/T)^2), t = s desde o 1º som. Calmo quase até o fim, despenca nos últimos ~20min; 30s em 2h. Sem jitter.
MUTED_CAP=30        # ponytail: Mac no mudo -> desmuta com o volume do sistema limitado a 30% só durante o som, e volta ao mudo
# opcional (brew install switchaudio-osx): sem ele, toca no dispositivo de saída atual. macOS não tem CLI nativa pra isso.
# Caminhos do brew explícitos: o PATH do launchd é mínimo e não inclui /opt/homebrew/bin.
SWITCH=''
for p_ in "$(command -v SwitchAudioSource || true)" /opt/homebrew/bin/SwitchAudioSource /usr/local/bin/SwitchAudioSource; do
  [[ -n $p_ && -x $p_ ]] && { SWITCH=$p_; break; }
done

# $1 = modo (ramp | normal | slow | fast | MIN-MAX em segundos), $2 = segundos desde o 1º som (só o ramp usa) -> segundos até o próximo som
gap_seconds() {
  local range g
  case $1 in
    ramp) local t=${2:-0} T=$RAMP_DURATION; (( t > T )) && t=$T
          echo $(( RAMP_MIN + (RAMP_START - RAMP_MIN) * (T * T - t * t) / (T * T) )); return ;;
    slow) range=1800-3000 ;; fast) range=10-13 ;; normal) range=90-210 ;; *) range=$1 ;;
  esac
  local min=${range%-*} max=${range#*-}
  echo $(( min + RANDOM % (max - min + 1) ))
}

# $1 = anterior, resto = candidatos -> um candidato aleatório diferente do anterior (repete se só há 1)
pick_next() {
  local prev=$1 f others=(); shift
  for f in "$@"; do [[ $f != "$prev" ]] && others+=("$f"); done
  (( ${#others[@]} )) || others=("$@")
  echo "${others[RANDOM % ${#others[@]}]}"
}

# $1 = volume em % (0-100) -> ganho linear do afplay (60 -> 0.60, 100 -> 1.00)
pct_to_gain() { printf '%d.%02d' $(( $1 / 100 )) $(( $1 % 100 )); }

# "output volume:75, input volume:48, alert volume:100, output muted:true" -> SYS_VOL=75 SYS_MUTED=true
parse_volume_settings() {
  SYS_VOL=0 SYS_MUTED=false
  [[ $1 =~ output\ volume:([0-9]+).*output\ muted:(true|false) ]] && SYS_VOL=${BASH_REMATCH[1]} SYS_MUTED=${BASH_REMATCH[2]}
}
read_sys_audio() { parse_volume_settings "$(osascript -e 'get volume settings' 2>/dev/null)"; }
set_sys_audio()  { osascript -e "set volume output volume $1" -e "set volume output muted $2" >/dev/null 2>&1; }   # $1 = 0-100, $2 = true|false

read_settings() {
  MODE_=ramp VOL_=60 LAZY_=0 PACK_=all
  [[ -f $SETTINGS ]] && read -r MODE_ VOL_ LAZY_ PACK_ < "$SETTINGS"
  VOL_=${VOL_:-60} LAZY_=${LAZY_:-0} PACK_=${PACK_:-all}
}
settings_str() { read_settings; echo "modo $MODE_, volume $VOL_%$( (( LAZY_ )) && echo ', lazy' )$([[ $PACK_ != all ]] && echo ", pacote $PACK_")"; }
packs() { (cd "$DIR/assets" && for d in */; do printf '%s ' "${d%/}"; done); }

die()     { echo "$*" >&2; exit 1; }
log()     { echo "$(date '+%F %T') $*"; }
running() { launchctl print "$DOMAIN/$LABEL" 2>/dev/null | grep -q $'^\tstate = running'; }
pid()     { launchctl print "$DOMAIN/$LABEL" 2>/dev/null | grep -m1 'pid = ' | awk '{print $3}'; }

# -> nome do alto-falante interno na lista de saídas (vazio se não achar ou sem SwitchAudioSource)
builtin_speaker() { [[ -n $SWITCH ]] && "$SWITCH" -a -t output 2>/dev/null | grep -m1 -iE 'speaker|alto-falante|built-in'; }

# desfaz o que play_file mexeu: volume/mudo e depois o dispositivo de saída
restore_audio() {
  [[ $SYS_MUTED == true ]] && set_sys_audio "$SYS_VOL" true
  [[ -n $PREV_DEV ]] && "$SWITCH" -s "$PREV_DEV" -t output >/dev/null 2>&1
  trap - TERM INT
}

# toca $1 no volume das settings, sempre no alto-falante do Mac (troca o device, toca, volta pro anterior).
# Mac no mudo: desmuta com cap, toca, volta ao mudo. Ambos desfeitos também se levar stop no meio (trap só durante o som).
# Deixa em PLAY_NOTE o sufixo pro log. SIGKILL no meio do som deixa desmutado / no alto-falante.
play_file() {
  local f=$1 cap spk; PLAY_NOTE='' PREV_DEV=''
  spk=$(builtin_speaker)
  if [[ -n $spk ]]; then
    PREV_DEV=$("$SWITCH" -c -t output 2>/dev/null)
    if [[ $spk == "$PREV_DEV" ]]; then PREV_DEV=''
    else "$SWITCH" -s "$spk" -t output >/dev/null 2>&1; PLAY_NOTE=" (saída: $spk)"; fi
  fi
  read_sys_audio   # depois da troca: volume e mudo são por dispositivo
  if [[ $SYS_MUTED == true ]]; then
    cap=$(( SYS_VOL < MUTED_CAP ? SYS_VOL : MUTED_CAP ))
    set_sys_audio "$cap" false
    PLAY_NOTE+=" (Mac no mudo: toquei a ${cap}% e voltei ao mudo)"
  fi
  [[ $SYS_MUTED == true || -n $PREV_DEV ]] && trap 'restore_audio; exit' TERM INT
  /usr/bin/afplay -v "$(pct_to_gain "$VOL_")" "$f" || log "erro ao tocar $f"
  restore_audio
}

write_plist() {
  cat > "$PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>$SELF</string><string>run</string></array>
  <key>RunAtLoad</key><true/>
  <key>AbandonProcessGroup</key><true/>
  <key>StandardOutPath</key><string>$LOG</string>
  <key>StandardErrorPath</key><string>$LOG</string>
</dict></plist>
PLIST
}

# loop em foreground; é isso que o launchd executa
cmd_run() {
  local prev='' f gap files t0
  read_settings
  log "iniciado ($(settings_str))"
  [[ -z $SWITCH ]] && log "aviso: SwitchAudioSource não instalado (brew install switchaudio-osx); toco no dispositivo de saída atual"
  (( LAZY_ )) && { log "lazy: primeiro som em $(( LAZY_SECONDS / 60 ))min"; sleep "$LAZY_SECONDS"; }
  t0=$(date +%s)
  while :; do
    # relido a cada ciclo: dá pra jogar sons novos sem reiniciar. Pacote = subpasta de assets/; all = todas.
    if [[ $PACK_ == all ]]; then files=("$DIR"/assets/*/*); else files=("$DIR"/assets/"$PACK_"/*); fi
    (( ${#files[@]} )) || { log "nenhum áudio em $DIR/assets/${PACK_/all/*}"; exit 1; }
    f=$(pick_next "$prev" "${files[@]}")
    play_file "$f"
    prev=$f
    gap=$(gap_seconds "$MODE_" $(( $(date +%s) - t0 )))
    log "tocou $(basename "$f")$PLAY_NOTE; próximo em ${gap}s"
    sleep "$gap"
  done
}

# start [ramp|normal|slow|fast|MIN-MAX] [N%] [lazy] [pacote], em qualquer ordem
cmd_start() {
  local a mode=ramp vol=60 lazy=0 pack=all
  for a in "$@"; do
    if [[ $a =~ ^(ramp|normal|slow|fast|([0-9]+)-([0-9]+))$ ]]; then
      mode=$a; [[ -n ${BASH_REMATCH[2]} ]] && (( BASH_REMATCH[2] > BASH_REMATCH[3] )) && die "faixa inválida: $a (MIN deve ser <= MAX)"
    elif [[ $a =~ ^([0-9]|[1-9][0-9]|100)%$ ]]; then vol=${a%\%}
    elif [[ $a == lazy ]]; then lazy=1
    elif [[ $a != */* && -d $DIR/assets/$a ]]; then pack=$a
    else die "argumento inválido: $a (use: ramp | normal | slow | fast | MIN-MAX em segundos, N% de volume, lazy, ou um pacote: $(packs))"
    fi
  done
  running && die "já está rodando (PID $(pid), $(settings_str)). Pra trocar: $SELF stop && $SELF start $*"
  echo "$mode $vol $lazy $pack" > "$SETTINGS"
  write_plist
  launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null   # limpa instância carregada mas já encerrada
  launchctl bootstrap "$DOMAIN" "$PLIST" || die "falhou ao iniciar"
  sleep 1
  running || die "falhou ao iniciar, veja $LOG"
  echo "rodando (PID $(pid), $(settings_str)). Parar: $SELF stop"
}

cmd_stop() {
  local p i=0; p=$(pid)
  if running; then launchctl bootout "$DOMAIN/$LABEL"; echo "parado. O som em curso termina sozinho."
  else launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null; echo "não estava rodando"; fi
  while [[ -n $p ]] && kill -0 "$p" 2>/dev/null && (( i++ < 75 )); do sleep 0.2; done   # espera o som em curso acabar (e o mudo voltar) antes da risada
  [[ -f $STOP_SOUND ]] && { read_settings; play_file "$STOP_SOUND"; log "stop: tocou $(basename "$STOP_SOUND")$PLAY_NOTE" >> "$LOG"; }
}

cmd_status() {
  if running; then echo "rodando (PID $(pid), $(settings_str))"; else echo "parado"; fi
  echo "autostart: $([[ -f $AGENT ]] && echo on || echo off)"
  echo "pacotes: $(packs)"
  echo "log: $LOG"
}

cmd_enable_autostart() {
  write_plist; mkdir -p "$(dirname "$AGENT")"; cp "$PLIST" "$AGENT"
  echo "autostart ativado: inicia sozinho no próximo login, com as opções do último start ($(settings_str))."
  echo "Aparece em Ajustes do Sistema > Geral > Itens de Início. Desativar: $SELF disable-autostart"
}

cmd_disable_autostart() { rm -f "$AGENT"; echo "autostart desativado. Se estiver rodando agora, continua até: $SELF stop"; }

cmd_uninstall() {
  [[ -e $DIR/.git ]] && die "isso é um checkout git, não uma instalação. Rode a partir de ~/.soundloop."
  cmd_stop; cmd_disable_autostart
  rm -rf "$DIR" && echo "soundloop removido ($DIR)"
}

usage() { cat <<EOT
soundloop — toca sons aleatórios em background. Brincadeira de escritório: consensual, visível e parável.

uso: $SELF <comando>
  start [modo] [N%] [lazy] [pacote]
                            inicia (default: ramp, 60%, sem lazy, todos os pacotes). Ordem livre.
                            modo: ramp 900s->30s em 2h, calmo e despenca no fim | normal 90-210s | slow 30-50min
                                  fast 10-13s | MIN-MAX segundos
                            N%: volume relativo ao do Mac | lazy: primeiro som só depois de 30min
                            pacote: subpasta de assets/ ($(packs)); sem pacote = todos
  stop                      para (o som em curso termina sozinho) e toca a risada
  status                    rodando/parado, PID, modo, volume, pacote, autostart
  enable-autostart          inicia sozinho no login com as opções do último start (visível em Itens de Início)
  disable-autostart         remove do login
  uninstall                 stop (com risada) + disable-autostart + apaga $DIR
obs: toca mesmo com o Mac no mudo (desmuta com o sistema limitado a 30% durante o som; volta ao mudo depois)
log: $LOG
EOT
}

main() {
  case ${1:-help} in
    start) shift; cmd_start "$@" ;;
    stop|status|run|uninstall) "cmd_$1" ;;
    enable-autostart) cmd_enable_autostart ;;
    disable-autostart) cmd_disable_autostart ;;
    help|-h|--help) usage ;;
    *) usage >&2; exit 1 ;;
  esac
}

[[ ${BASH_SOURCE[0]} == "$0" ]] && main "$@"
